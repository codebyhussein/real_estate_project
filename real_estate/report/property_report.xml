<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_property_summary">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Property Summary: <span t-field="o.name"/></h2>
                    
                    <!-- Property Details -->
                    <div class="row mt-4">
                        <div class="col-6">
                            <strong>Property Type:</strong>
                            <span t-field="o.property_type"/>
                        </div>
                        <div class="col-6">
                            <strong>Status:</strong>
                            <t t-if="o.available">
                                <span class="badge rounded-pill text-bg-success">Available</span>
                            </t>
                            <t t-else="">
                                <span class="badge rounded-pill text-bg-danger">Occupied</span>
                            </t>
                            <div class="mt-2">
                                <strong>Occupancy Rate:</strong>
                                <span t-esc="round(occupancy_rate, 2)"/>%
                            </div>
                        </div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-6">
                            <strong>Description:</strong><br/>
                            <span t-field="o.description"/>
                        </div>
                        <div class="col-6">
                            <strong>Bedrooms:</strong>
                            <span t-field="o.bedrooms"/>
                        </div>
                    </div>

                    <!-- Pricing -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <h4>Pricing Information</h4>
                            <table class="table table-sm">
                                <tr>
                                    <td><strong>Monthly Rent:</strong></td>
                                    <td class="text-end">
                                        <span t-field="o.price" 
                                            t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Security Deposit:</strong></td>
                                    <td class="text-end">
                                        <span t-field="o.deposit" 
                                            t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Maintenance Costs (Last 6 Months):</strong></td>
                                    <td class="text-end">
                                        <span t-out="maintenance_costs.get(o.id, 0.0)"
                                            t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- Active Lease Info -->
                    <t t-if="o.lease_ids">
                        <div class="row mt-4">
                            <div class="col-12">
                                <h4>Current Lease</h4>
                                <t t-set="active_lease" t-value="o.lease_ids.filtered(lambda l: l.state == 'active')[:1]"/>
                                <t t-if="active_lease">
                                    <table class="table table-sm">
                                        <tr>
                                            <td><strong>Tenant:</strong></td>
                                            <td><span t-field="active_lease.tenant_id"/></td>
                                        </tr>
                                        <tr>
                                            <td><strong>Monthly Rent:</strong></td>
                                            <td>
                                                <span t-field="active_lease.monthly_rent" 
                                                    t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td><strong>Start Date:</strong></td>
                                            <td><span t-field="active_lease.start_date"/></td>
                                        </tr>
                                        <tr>
                                            <td><strong>End Date:</strong></td>
                                            <td><span t-field="active_lease.end_date"/></td>
                                        </tr>
                                    </table>
                                </t>
                                <t t-else="">
                                    <p class="text-muted">No active lease</p>
                                </t>
                            </div>
                        </div>
                    </t>

                    <t t-set="property_payments" t-value="payments_by_property.get(o.id, [])"/>
                    <div class="row mt-4">
                        <div class="col-12">
                            <h4>Property Payments</h4>
                            <t t-if="property_payments">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th>Reference</th>
                                            <th>Tenant</th>
                                            <th>Due Date</th>
                                            <th>Payment Date</th>
                                            <th>Method</th>
                                            <th>Status</th>
                                            <th class="text-end">Amount</th>
                                            <th class="text-end">Late Fee</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="property_payments" t-as="payment">
                                            <tr>
                                                <td><span t-field="payment.name"/></td>
                                                <td><span t-field="payment.tenant_id"/></td>
                                                <td><span t-field="payment.due_date"/></td>
                                                <td><span t-field="payment.payment_date"/></td>
                                                <td><span t-field="payment.payment_method"/></td>
                                                <td><span t-field="payment.state"/></td>
                                                <td class="text-end">
                                                    <span t-field="payment.amount"
                                                        t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                                </td>
                                                <td class="text-end">
                                                    <span t-field="payment.late_fee"
                                                        t-options="{'widget': 'monetary', 'display_currency': res_company.currency_id}"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>
                            <t t-else="">
                                <p class="text-muted">No payments recorded.</p>
                            </t>
                        </div>
                    </div>



                    <!-- Footer Note -->
                    <div class="row mt-5">
                        <div class="col-12">
                            <p class="text-muted">
                                <small>
                                    Generated on <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
                                </small>
                            </p>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </t>
</template>

    

</odoo>
