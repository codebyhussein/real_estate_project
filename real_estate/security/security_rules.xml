<odoo>
   
    <!-- Security group property -->

    <record id="group_agent" model="res.groups">
        <field name="name">Real Estate Agent</field>
    </record>
    
    <record id="group_property_manager" model="res.groups">
        <field name="name">Property Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_agent'))]"/>
    </record>



    <record id="property_agent_rule" model="ir.rule">
        <field name="name">Agent: Own Properties Only</field>
        <field name="model_id" ref="model_real_estate_property"/>
        <field name="domain_force">[('agent_id', '=', user.id)]</field> 
        <field name="groups" eval="[(4, ref('group_agent'))]"/>
    </record>
    


    <record id="property_manager_rule" model="ir.rule">
        <field name="name">Manager: All Properties</field>
        <field name="model_id" ref="model_real_estate_property"/>
        <field name="domain_force">[]</field>
        <field name="groups" eval="[(4, ref('group_property_manager'))]"/>
    </record>   

<!-- Security group tenant  -->
        
    <record id="group_tenant" model="res.groups">
        <field name="name">Tenant</field>
    </record>

    <record id="group_tenant_manager" model="res.groups">
        <field name="name">Tenant Manager</field>
    </record>

        <record id="user_tenant_rule" model="ir.rule">
        <field name="name">Tenant: Related Tenant Rule</field>
        <field name="model_id" ref="model_real_estate_tenant"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_tenant'))]"/>
    </record>


        <record id="manager_tenant_rule" model="ir.rule">
        <field name="name">Manager: All Tenant</field>
        <field name="model_id" ref="model_real_estate_tenant"/>
        <field name="domain_force">[]</field>
        <field name="groups" eval="[(4, ref('group_tenant_manager'))]"/>
    </record>    
 
<!-- leases Security group -->

        <record id="group_lease_user" model="res.groups">
        <field name="name">Lease</field>
    </record>

    <record id="group_lease_manager" model="res.groups">
        <field name="name">Lease Manager</field>
    </record>




    <record id="lease_user" model="ir.rule">
        <field name="name">Leses : User</field>
        <field name="model_id" ref="model_real_estate_lease"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_lease_user'))]"/>
    </record>

        <record id="lease_manager" model="ir.rule">
        <field name="name">Leses : Manager</field>
        <field name="model_id" ref="model_real_estate_lease"/>
        <field name="domain_force">[]</field>
        <field name="groups" eval="[(4, ref('group_lease_manager'))]"/>
    </record>
    

    <!-- Maintance Request Secuity -->

         <record id="group_maintenance_user" model="res.groups">
        <field name="name">Maintenance User</field>
    </record>
          <record id="group_maintenance_manager" model="res.groups">
        <field name="name">Maintenance Manager</field>
    </record>
   <record id="maintenance_user" model="ir.rule">
        <field name="name">Maintenance : User</field>
        <field name="model_id" ref="model_maintenance_request"/>
        <field name="domain_force">[('assigned_to', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_maintenance_user'))]"/>
    </record>

        <record id="maintenance_manager" model="ir.rule">
        <field name="name">Maintenance : Manager</field>
        <field name="model_id" ref="model_maintenance_request"/>
        <field name="domain_force">[]</field>
        <field name="groups" eval="[(4, ref('group_maintenance_manager'))]"/>
    </record>

</odoo>

