<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_maintenance_report_wizard_form" model="ir.ui.view">
        <field name="name">maintenance.report.wizard.form</field>
        <field name="model">maintenance.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Maintenance Report">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="issue_type"/>
                   
                    </group>
                                        <group>
                        <field name="urgency"/>
                        <field name="property_id"/>
                        

                   
                    </group>
                </group>
                
                <group invisible="not excel_file">
                    <field name="excel_file" filename="excel_filename" readonly="1"/>
                    <field name="excel_filename" invisible="1"/>
                </group>
                
                <footer>
                    <button string="Generate Report" 
                            name="action_generate_report" 
                            type="object" 
                            class="btn-primary"
                            invisible="excel_file != False"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_maintenance_report_wizard" model="ir.actions.act_window">
        <field name="name">Maintenance Report</field>
        <field name="res_model">maintenance.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


</odoo>