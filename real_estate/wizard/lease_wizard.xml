<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Lease Wizard View -->
    <record id="view_lease_wizard_form" model="ir.ui.view">
        <field name="name">lease.wizard.form</field>
        <field name="model">real_estate.lease.wizard</field>
        <field name="arch" type="xml">

            <form string="Create Lease">

                <group>
                    <group>
                        <field name="name"/>
                        <field name="property_id"/>
                        <field name="tenant_id"/>
                    </group>

                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="user_id"/>
                    </group>
                </group>

                <group>
                    <group>
                        <field name="monthly_rent"/>
                        <field name="deposit_paid"/>
                    </group>

                    <group>
                        <field name="state"/>
                    </group>
                </group>

                <footer>
                    <button
                        name="action_create_lease"
                        string="Create Lease"
                        type="object"
                        class="oe_highlight"/>

                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"/>
                </footer>

            </form>

        </field>
    </record>

    <!-- Lease Wizard Action -->
    <record id="real_estate.action_lease_wizard" model="ir.actions.act_window">
        <field name="name">Create Lease</field>
        <field name="res_model">real_estate.lease.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>