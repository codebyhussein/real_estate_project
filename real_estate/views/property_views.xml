<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Property List View (Tree) -->
    <record id="view_property_tree" model="ir.ui.view">
        <field name="name">real_estate.property.tree</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
            <tree string="Properties" decoration-info="property_type == 'apartment'"
                decoration-warning="property_type == 'villa'">
                <field name="name" />

                <field name="price" />
                <field name="bedrooms" />
                <field name="available" />
                <field name="description" />
                <field name="create_date" />
                <field name="create_uid" />
                <field name="agent_id" />
                <field name="property_type" />


            </tree>
        </field>
    </record>

    <!-- Property Form View -->
    <record id="view_property_form" model="ir.ui.view">
        <field name="name">real_estate.property.form</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">

                <header>
                    <button name="mark_as_occupied" string="Mark as Occupied" type="object"
                        groups="real_estate.group_property_manager"
                        invisible="not available" class="oe_highlight" />
                    <button name="mark_as_available" string="Mark as Available" type="object"
                        invisible="available" class="oe_highlight" />
                    <button name="add_text" string="Add Text" type="object" class="oe_highlight" />
                    <button name="increse_deposit" string="Increase Deposit" type="object"
                        class="oe_highlight" />
                    <button name="add_bedroom" string="Add Bedroom" type="object"
                        invisible="available" class="oe_highlight" />
                    <button name="mark_as_villa" string="Mark as Villa" type="object"
                        class="oe_highlight" />
                    <button name="get_agent_name" string="Get Agent Name" type="object"
                        class="oe_highlight" />

                    <field name="available" invisible="1" />
                    <button name="%(real_estate.action_lease_wizard)d"
                        string="Create Lease" type="action"
                        context="{'default_property_id': active_id,
                        'default_monthly_rent':price
                        
                        }"
                    />
                    <!-- 
                        <button name="action_open_lease_wizard"
        string="Create Lease"
        type="object"
        invisible="not available"/> -->


                </header>


                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Property Name" />
                        </h1>
                    </div>
                    <group string="Property Details">
                        <group>
                            <field name="property_type" />
                            <field name="available" />

                        </group>
                        <group>
                            <field name="price" />
                            <field name="deposit" string="Deposit Amount" />
                            <field name="agent_id" />

                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="bedrooms" />
                            <field name="create_date" />
                            <field name="create_uid" />
                        </group>
                    </group>
                    <notebook>
                        <!-- <page string="Description">
                            <field name="description"/>
                        </page> -->
                        <page string="Agent Name">
                            <field name="description" />

                        </page>

                        <page string="Leases">
                            <field name="lease_ids">
                                <tree create="false">
                                    <field name="name" />
                                    <field name="tenant_id" />
                                    <field name="start_date" />
                                    <field name="end_date" />
                                </tree>
                            </field>
                        </page>

                    </notebook>
                </sheet>
   <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>

            </form>
        </field>
    </record>


    <!-- Property Kanban View -->
    <record id="view_property_kanban" model="ir.ui.view">
        <field name="name">real_estate.property.kanban</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name" />

                <field name="price" />
                <field name="bedrooms" />
                <field name="available" />
                <field name="description" />

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name" />
                                </strong>
                                <div class="mt-1"> Price: <field name="price" />
                                </div>
                                <div class="text-muted mt-1"> Bedrooms: <field name="bedrooms" />
                                </div>
                                <div class="text-muted mt-1"> Available: <field name="available" />
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <!-- Property Search View -->
    <record id="view_property_search" model="ir.ui.view">
        <field name="name">real_estate.property.search</field>
        <field name="model">real_estate.property</field>
        <field name="arch" type="xml">
            <search string="Search Properties">
                <field name="name" />
                <field name="price" />
                <field name="bedrooms" />
                <separator />
                <filter string="Available" name="available" domain="[('available', '=', True)]" />
                <filter string="Not Available" name="not_available"
                    domain="[('available', '=', False)]" />
                <separator />
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_by_type"
                        context="{'group_by': 'property_type'}" />
                    <filter string="Availability" name="group_by_availability"
                        context="{'group_by': 'available'}" />
                </group>
            </search>
        </field>
    </record>


    <!-- Property Action (Links views together) -->
    <record id="action_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">real_estate.property</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first property
            </p>
        </field>
    </record>
</odoo>