<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="crm_lead_view_form_inherit" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">



        <header position="inside">
            <button name="get_name" string="Add Text" type="object" class="oe_highlight"/>

        <button name="%(action_tenant_wizard)d"
                        string="Create Tenant" type="action"
                        context="{'default_led_id': active_id,
                        'default_name':name,
                        'default_email':email_from
               
                        }" />
        </header>

            <xpath expr="//field[@name='user_id']" position="before">
                <field name="property_type"/>
            </xpath>

            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="string">Salesman</attribute>
            </xpath>

            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="string">Expected Date</attribute>
                <attribute name="required">true</attribute>
            </xpath>



<!-- 
                        <xpath expr="//field[@name='description']" position="inside">
                <field name="description"/>
            </xpath> -->
        </field>
    </record>


    <record id="create_tenant_cron" model="ir.cron">
        <field name="name">create Tenant </field>
        <field name="model_id" ref="model_real_estate_tenant"/>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="state">code</field>
        <field name="code">model._cron_create_tenant()</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>

      
<field
    name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=2, minute=0, second=0).strftime('%Y-%m-%d %H:%M:%S')"
/>
        
    </record>

</odoo>
