<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="crm_lead_view_form_inherit" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">



        <header position="inside">
            <button name="get_name" string="Add Text" type="object" class="oe_highlight"/>
        </header>

            <xpath expr="//field[@name='user_id']" position="before">
                <field name="property_type"/>
            </xpath>

            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="string">Salesman</attribute>
            </xpath>

            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="string">Expected Date</attribute>
                <attribute name="required">true</attribute>
            </xpath>



<!-- 
                        <xpath expr="//field[@name='description']" position="inside">
                <field name="description"/>
            </xpath> -->
        </field>
    </record>

</odoo>
