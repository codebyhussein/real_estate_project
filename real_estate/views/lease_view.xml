<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================================================
         Lease Tree View
    ========================================================== -->

    <record id="lease_view_tree" model="ir.ui.view">
        <field name="name">real_estate.lease.tree</field>
        <field name="model">real_estate.lease</field>

        <field name="arch" type="xml">
            <tree string="Leases">
                <field name="name"/>
                <field name="tenant_id"/>
                <field name="property_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="monthly_rent"/>
                <field name="duration_months"/>
                <field name="state"/>
                <field name="user_id"/>
            </tree>
        </field>
    </record>


    <!-- =========================================================
         Lease Form View
    ========================================================== -->

    <record id="real_estate.lease_form_view" model="ir.ui.view">
        <field name="name">real_estate.lease.form</field>
        <field name="model">real_estate.lease</field>

        <field name="arch" type="xml">
            <form string="Lease">

                <header>

                    <button
                        name="activate_lease"
                        string="Set to Active"
                        type="object"
                        class="oe_highlight"
                        invisible="state == 'active' or state == 'cancelled'"
                    />

                    <button
                        name="draft_lease"
                        string="Set to Draft"
                        type="object"
                        invisible="state == 'draft' or state == 'cancelled'"
                    />

                    <button
                        name="cancel_lease"
                        string="Cancel"
                        type="object"
                        invisible="state == 'cancelled'"
                    />

                    <button
                        name="action_create_maintenance"
                        string="Maintenance Request"
                        type="object"
                        class="oe_highlight"
                        invisible="state == 'cancelled'"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,active,at_risk,expired,cancelled"
                    />

                </header>

                <sheet>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field
                                name="name"
                                placeholder="Lease Reference..."
                            />
                        </h1>
                    </div>

                    <group>

                        <group string="Lease Information">
                            <field name="tenant_id"/>
                            <field name="property_id"/>
                            <field name="monthly_rent"/>
                            <field name="deposit_paid"/>
                            <field name="user_id"/>
                        </group>

                        <group string="Lease Period">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="duration_months"/>
                            <field name="is_active"/>
                            <field name="next_electric_recharge"/>
                        </group>

                    </group>

                    <group string="Maintenance Costs">

                        <group>
                            <field name="plumbing_cost"/>
                            <field name="electrical_cost"/>
                            <field name="air_condition_cost"/>
                        </group>

                        <group>
                            <field name="appliance_cost"/>
                            <field name="other_cost"/>
                            <field name="total_cost"/>
                        </group>

                    </group>

                    <notebook>

                        <page string="Maintenance Requests">

                            <field name="maintenance_request_ids">

                                <tree create="false" delete="false">
                                    <field name="name"/>
                                    <field name="issue_type"/>
                                    <field name="urgency"/>
                                    <field name="assigned_to"/>
                                    <field name="preferred_date"/>
                                    <field name="scheduled_date"/>
                                    <field name="completion_date"/>
                                    <field name="actual_cost"/>
                                    <field name="state"/>
                                </tree>

                            </field>

                        </page>

                    </notebook>

                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>

            </form>
        </field>
    </record>


    <!-- =========================================================
         Lease Search View
    ========================================================== -->

    <record id="lease_view_search" model="ir.ui.view">
        <field name="name">real_estate.lease.search</field>
        <field name="model">real_estate.lease</field>

        <field name="arch" type="xml">
            <search string="Search Leases">

                <field name="name"/>
                <field name="tenant_id"/>
                <field name="property_id"/>
                <field name="state"/>
                <field name="start_date"/>
                <field name="end_date"/>

                <separator/>

                <filter
                    name="filter_active"
                    string="Active"
                    domain="[('state', '=', 'active')]"
                />

                <filter
                    name="filter_at_risk"
                    string="At Risk"
                    domain="[('state', '=', 'at_risk')]"
                />

                <filter
                    name="filter_expired"
                    string="Expired"
                    domain="[('state', '=', 'expired')]"
                />

                <filter
                    name="filter_cancelled"
                    string="Cancelled"
                    domain="[('state', '=', 'cancelled')]"
                />

                <separator/>

                <group expand="0" string="Group By">

                    <filter
                        name="group_by_state"
                        string="Status"
                        context="{'group_by': 'state'}"
                    />

                    <filter
                        name="group_by_tenant"
                        string="Tenant"
                        context="{'group_by': 'tenant_id'}"
                    />

                    <filter
                        name="group_by_property"
                        string="Property"
                        context="{'group_by': 'property_id'}"
                    />

                </group>

            </search>
        </field>
    </record>


    <!-- =========================================================
         Lease Kanban View
    ========================================================== -->

    <record id="lease_view_kanban" model="ir.ui.view">
        <field name="name">real_estate.lease.kanban</field>
        <field name="model">real_estate.lease</field>

        <field name="arch" type="xml">
            <kanban default_group_by="state">

                <field name="name"/>
                <field name="tenant_id"/>
                <field name="property_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="monthly_rent"/>
                <field name="state"/>

                <templates>

                    <t t-name="kanban-box">

                        <div class="oe_kanban_card oe_kanban_global_click">

                            <div class="d-flex justify-content-between align-items-center mb-2">

                                <strong class="fs-5">
                                    <field name="name"/>
                                </strong>

                                <field name="state" widget="badge"/>

                            </div>

                            <hr class="my-2"/>

                            <div class="mb-2">
                                <div class="text-muted small">
                                    Tenant
                                </div>

                                <div class="fw-bold">
                                    <field name="tenant_id"/>
                                </div>
                            </div>

                            <div class="mb-2">
                                <div class="text-muted small">
                                    Property
                                </div>

                                <div class="fw-bold">
                                    <field name="property_id"/>
                                </div>
                            </div>

                            <div class="row mt-3">

                                <div class="col-6">
                                    <div class="text-muted small">
                                        Start Date
                                    </div>

                                    <field name="start_date"/>
                                </div>

                                <div class="col-6">
                                    <div class="text-muted small">
                                        End Date
                                    </div>

                                    <field name="end_date"/>
                                </div>

                            </div>

                        </div>

                    </t>

                </templates>

            </kanban>
        </field>
    </record>


    <!-- =========================================================
         Lease Action
    ========================================================== -->

    <record id="lease_action" model="ir.actions.act_window">

        <field name="name">Leases</field>
        <field name="res_model">real_estate.lease</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="search_view_id" ref="lease_view_search"/>

        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first lease!
            </p>

            <p>
                Manage your property leases, tenants, rent,
                maintenance and lease periods from one place.
            </p>
        </field>

    </record>

</odoo>