<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <!-- Tenant List View (Tree) -->
    <record id="view_tenant_tree" model="ir.ui.view">
        <field name="name">real_estate.tenant.tree</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">
            <tree string="Tenants">
                <field name="name" />
                <field name="email" />
                <field name="mobile" />
                <field name="city" />
                <field name="date_joined" />


            </tree>
        </field>
    </record> ```xml     <!-- Tenant Form View -->
<record
        id="view_tenant_form" model="ir.ui.view">
        <field name="name">real_estate.tenant.form</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">
            <form string="Tenant">
                <header>

                    <button name="update_notes" string="Update Notes" type="object"
                        class="oe_highlight" />
                </header>

                <sheet>
                    <h1>
                        <field name="name" placeholder="Tenant Name" size="40" string="Tenant Name"
                            label="Name" />

                    </h1>


                    <group string="Tenant Information">
                        <group>
                            <field name="email" />
                            <field name="mobile" />
                            <field name="city" />
                        </group>

                        <group string="Additional Information">
                            <field name="date_joined" />
                            <field name="active" />
                            <field name="crm_id" />
                        </group>
                    </group>

                    <notebook>
                        <page name="info" string="Info">
                            <group>
                                <field name="notes" />
                            </group>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>
    ``` <!-- Tenant Kanban View -->
    <record id="view_tenant_kanban" model="ir.ui.view">
        <field name="name">real_estate.tenant.kanban</field>
        <field name="model">real_estate.tenant</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name" />
                <field name="email" />
                <field name="date_joined" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name" />
                                </strong>
                                <div class="mt-1">
                                    <field name="email" widget="email" />
                                </div>
                                <div class="text-muted mt-1"> Joined: <field name="date_joined" />
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <!-- Tenant action -->
    <record
        id="action_tenant" model="ir.actions.act_window">
        <field name="name">Tenants</field>
        <field name="res_model">real_estate.tenant</field>
        <field name="view_mode">tree,form,kanban</field>
    </record>
</odoo>