<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================================================
         Maintenance Request Tree View
    ========================================================== -->

    <record id="maintenance_request_view_tree" model="ir.ui.view">

        <field name="name">maintenance.request.tree</field>
        <field name="model">maintenance.request</field>

        <field name="arch" type="xml">
            <tree string="Maintenance Requests">

                <field name="name"/>
                <field name="lease_id"/>
                <field name="tenant_id"/>
                <field name="property_id"/>
                <field name="issue_type"/>
                <field name="urgency"/>
                <field name="assigned_to"/>
                <field name="preferred_date"/>
                <field name="scheduled_date"/>
                <field name="completion_date"/>
                <field name="actual_cost"/>
                <field name="state"/>

            </tree>
        </field>

    </record>


    <!-- =========================================================
         Maintenance Request Form View
    ========================================================== -->

    <record id="maintenance_request_view_form" model="ir.ui.view">

        <field name="name">maintenance.request.form</field>
        <field name="model">maintenance.request</field>

        <field name="arch" type="xml">
            <form string="Maintenance Request">

                <header>

                    <button
                        name="action_start"
                        string="Start"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'submitted'"
                    />

                    <button
                        name="action_complete"
                        string="Complete"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'in_progress'"
                    />

                    <button
                        name="action_cancel"
                        string="Cancel"
                        type="object"
                        invisible="state == 'cancelled' or state == 'completed'"
                    />

                    <button
                        name="action_reset"
                        string="Reset"
                        type="object"
                        invisible="state == 'submitted'"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="submitted,in_progress,completed,cancelled"
                    />

                </header>

                <sheet>

                    <div class="oe_title">

                        <label for="name"/>

                        <h1>
                            <field name="name"/>
                        </h1>

                    </div>

                    <group>

                        <group string="Property Information">

                            <field name="lease_id"/>
                            <field name="tenant_id" readonly="1"/>
                            <field name="property_id" readonly="1"/>
                            <field name="tenant_phone"/>

                        </group>

                        <group string="Maintenance Information">

                            <field name="issue_type"/>
                            <field name="urgency"/>
                            <field name="assigned_to"/>

                        </group>

                    </group>

                    <group string="Problem Description">

                        <field
                            name="description"
                            placeholder="Describe the maintenance issue..."
                        />

                    </group>

                    <group string="Schedule &amp; Cost">

                        <group>

                            <field name="preferred_date"/>
                            <field name="scheduled_date"/>
                            <field name="completion_date"/>

                        </group>

                        <group>

                            <field name="actual_cost"/>

                        </group>

                    </group>

                </sheet>

                <div class="oe_chatter">

                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>

                </div>

            </form>
        </field>

    </record>


    <!-- =========================================================
         Maintenance Request Search View
    ========================================================== -->

    <record id="maintenance_request_view_search" model="ir.ui.view">

        <field name="name">maintenance.request.search</field>
        <field name="model">maintenance.request</field>

        <field name="arch" type="xml">
            <search string="Search Maintenance Requests">

                <field name="name"/>
                <field name="lease_id"/>
                <field name="tenant_id"/>
                <field name="property_id"/>
                <field name="issue_type"/>
                <field name="urgency"/>
                <field name="assigned_to"/>
                <field name="state"/>

                <separator/>

                <filter
                    name="high_urgency"
                    string="High"
                    domain="[('urgency', '=', 'high')]"
                />

                <filter
                    name="emergency"
                    string="Emergency"
                    domain="[('urgency', '=', 'emergency')]"
                />

                <filter
                    name="scheduled"
                    string="Scheduled"
                    domain="[('scheduled_date', '!=', False)]"
                />

                <filter
                    name="completed"
                    string="Completed"
                    domain="[('state', '=', 'completed')]"
                />

                <separator/>

                <group expand="0" string="Group By">

                    <filter
                        name="group_lease"
                        string="Lease"
                        context="{'group_by': 'lease_id'}"
                    />

                    <filter
                        name="group_property"
                        string="Property"
                        context="{'group_by': 'property_id'}"
                    />

                    <filter
                        name="group_tenant"
                        string="Tenant"
                        context="{'group_by': 'tenant_id'}"
                    />

                    <filter
                        name="group_issue_type"
                        string="Issue Type"
                        context="{'group_by': 'issue_type'}"
                    />

                    <filter
                        name="group_urgency"
                        string="Urgency"
                        context="{'group_by': 'urgency'}"
                    />

                    <filter
                        name="group_assigned_to"
                        string="Assigned To"
                        context="{'group_by': 'assigned_to'}"
                    />

                    <filter
                        name="group_state"
                        string="Status"
                        context="{'group_by': 'state'}"
                    />

                </group>

            </search>
        </field>

    </record>

 
         <record id="ir_cron_auto_urgency" model="ir.cron">
        <field name="name">Real Estate: Auto Urgency</field>
        <field name="model_id" ref="model_maintenance_request"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_complete_maintenance_requests()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record> 
    <!-- =========================================================
         Maintenance Request Action
    ========================================================== -->

    <record id="action_maintenance_request" model="ir.actions.act_window">

        <field name="name">Maintenance Requests</field>
        <field name="res_model">maintenance.request</field>
        <field name="view_mode">tree,form</field>

        <field
            name="search_view_id"
            ref="maintenance_request_view_search"
        />

    </record>


 

</odoo>