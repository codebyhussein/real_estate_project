<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_lease_maintenance_smart_button" model="ir.ui.view">

        <field name="name">real_estate.lease.maintenance.smart.button</field>
        <field name="model">real_estate.lease</field>
        <field name="inherit_id" ref="real_estate.lease_form_view"/>

        <field name="arch" type="xml">

            <xpath expr="//sheet" position="inside">

                <div name="button_box" class="oe_button_box">

                    <button
                        name="action_view_maintenance"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-wrench"
                    >
                        <field
                            name="maintenance_count"
                            widget="statinfo"
                            string="Maintenance"
                        />
                    </button>

                </div>

            </xpath>

        

            <xpath expr="//notebook" position="inside">

                <page name="payment_summary" string="Payment Summary">

                    <group>

                        <group string="Amounts by Payment Method">
                            <field name="total_viza_amount" widget="monetary"/>
                            <field name="total_cash_amount" widget="monetary"/>
                            <field name="total_credit_card_amount" widget="monetary"/>
                            <field name="total_check_amount" widget="monetary"/>
                            <field name="total_other_amount" widget="monetary"/>
                        </group>

                        <group string="Overall Total">
                            <field name="total_amount" widget="monetary"/>
                        </group>

                    </group>

                </page>

            </xpath>

        </field>

    </record>

</odoo>