<?xml version="1.0" encoding="utf-8"?>
<odoo>


<record id="email_template_payment_upcoming" model="mail.template">
<field name="name">Lease: Upcoming Payment Reminder</field>
<field name="model_id" ref="real_estate.model_real_estate_lease"/>
<field name="subject">Upcoming Rent Payment for {{ object.property_id.name }}</field>
<field name="email_from">{{ (object.property_id.agent_id.email_formatted or user.email_formatted) }}</field>
<field name="email_to">{{ object.tenant_id.email }}</field>
<field name="body_html" type="html">
    <div style="margin: 0px; padding: 0px;">
        <p style="margin: 0px; padding: 0px; font-size: 13px;">
            Dear <t t-out="object.tenant_id.name"/>,<br/><br/>
            This is a friendly reminder that your rent payment for <strong><t t-out="object.property_id.name"/></strong> 
            is due on <strong><t t-out="object.next_payment_date"/></strong>.<br/><br/>
            Amount Due: <strong><t t-out="object.monthly_rent"/></strong><br/><br/>
            Please ensure the payment is made by the due date to avoid any late fees.<br/><br/>
            Best regards,<br/>
            <t t-out="object.property_id.agent_id.name or 'Real Estate Management'"/>
        </p>
    </div>
</field>
<field name="auto_delete" eval="True"/>
</record>




    <record id="email_template_payment_upcoming" model="mail.template">

        <field name="name">Lease: Upcoming Payment Reminder</field>

        <field name="model_id" ref="real_estate.model_real_estate_lease"/>

        <field name="subject">
            Upcoming Rent Payment - {{ object.property_id.name }}
        </field>

        <field name="email_from">
            {{ (object.property_id.agent_id.email_formatted or user.email_formatted) }}
        </field>

        <field name="email_to">
            {{ object.tenant_id.email }}
        </field>

        <field name="body_html" type="html">
            <div style="margin: 0; padding: 0; background-color: #f4f6f8;">
                <div style="max-width: 600px; margin: 0 auto; padding: 30px 20px;">

                    <div style="background-color: #ffffff; padding: 30px; border-radius: 8px;">

                        <h2 style="margin-top: 0; color: #2c3e50;">
                            Upcoming Rent Payment Reminder
                        </h2>

                        <p style="font-size: 14px; color: #555;">
                            Dear
                            <strong>
                                <t t-out="object.tenant_id.name"/>
                            </strong>,
                        </p>

                        <p style="font-size: 14px; color: #555; line-height: 1.6;">
                            This is a friendly reminder that your upcoming
                            rent payment is due tomorrow.
                        </p>

                        <div style="background-color: #f8f9fa;
                                    padding: 20px;
                                    margin: 20px 0;
                                    border-left: 4px solid #875A7B;">

                            <p style="margin: 8px 0;">
                                <strong>Property:</strong>
                                <t t-out="object.property_id.name"/>
                            </p>

                            <p style="margin: 8px 0;">
                                <strong>Payment Date:</strong>
                                <t t-out="object.next_payment_date"/>
                            </p>

                            <p style="margin: 8px 0;">
                                <strong>Amount Due:</strong>
                                <t t-out="object.monthly_rent"/>
                            </p>

                        </div>

                        <p style="font-size: 14px; color: #555; line-height: 1.6;">
                            Please make sure that the payment is completed
                            by the due date.
                        </p>

                        <p style="font-size: 14px; color: #555;">
                            If you have already made the payment, please
                            disregard this reminder.
                        </p>

                        <br/>

                        <p style="font-size: 14px; color: #555;">
                            Best regards,<br/>
                            <strong>
                                <t t-out="object.property_id.agent_id.name or 'Real Estate Management'"/>
                            </strong>
                        </p>

                    </div>

                </div>
            </div>
        </field>

        <field name="auto_delete" eval="True"/>

    </record>


    <record id="email_template_maintenance_upcoming" model="mail.template">
    <field name="name">Maintenance Request Reminder</field>

    <field name="model_id" ref="real_estate.model_maintenance_request"/>

    <field name="subject">
        Maintenance Request Reminder - {{ object.name }}
    </field>

    <field name="email_from">
        {{ user.email or '' }}
    </field>

    <field name="email_to">
        {{ object.assigned_to.email or '' }}
    </field>

    <field name="body_html" type="html">
        <div>
            <p>
                Hello <t t-out="object.assigned_to.name or ''"/>,
            </p>

            <p>
                This is a reminder that you have a maintenance request
                scheduled for tomorrow.
            </p>

            <p>
                <strong>Request:</strong>
                <t t-out="object.name"/>
            </p>

            <p>
                <strong>Property:</strong>
                <t t-out="object.property_id.name or ''"/>
            </p>

            <p>
                <strong>Tenant:</strong>
                <t t-out="object.tenant_id.name or ''"/>
            </p>

            <p>
                <strong>Preferred Date:</strong>
                <t t-out="object.preferred_date or ''"/>
            </p>

             

            <p>
                Please make sure to handle this request as scheduled.
            </p>

            <p>
                Best regards,<br/>
                <t t-out="user.name"/>
            </p>
        </div>
    </field>

    <field name="auto_delete" eval="True"/>
</record>


</odoo>
